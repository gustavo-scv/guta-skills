{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/agent-skill.schema.json",
  "title": "Agent Skill Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "entrypoint",
    "files",
    "agents",
    "install"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "type": "string",
      "const": "SKILL.md"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "install": {
      "type": "object",
      "required": [
        "copyDirectory",
        "preserveRelativePaths"
      ],
      "properties": {
        "copyDirectory": {
          "type": "boolean",
          "const": true
        },
        "preserveRelativePaths": {
          "type": "boolean",
          "const": true
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
